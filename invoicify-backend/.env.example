# ====================================================================
# COPY THIS FILE TO ".env" AND FILL IN YOUR REAL VALUES
# (In terminal:  copy .env.example .env   on Windows)
# The .env file is SECRET — never commit it to GitHub.
# ====================================================================

# Your MongoDB Atlas connection string.
# Paste the string you copied from Atlas, and replace <password>
# with your real database user password (remove the < > brackets).
# Also add your database name after .net/  (e.g. .net/invoicify)
MONGODB_URI=mongodb+srv://your_user:[email protected]/invoicify?retryWrites=true&w=majority

# A long random secret used to sign login tokens (JWT).
# Type any long random string of letters/numbers here.
JWT_SECRET=change_this_to_a_long_random_secret_string_12345

# Port the backend server runs on
PORT=5000

# Your frontend URL (for CORS). Vite dev server default:
CLIENT_URL=http://localhost:5173

# ====================================================================
# EMAIL (password-reset codes) — optional but needed for real emails.
# Works with ANY SMTP provider. Use an APP PASSWORD (not your login password).
# If you leave these blank, the reset code is printed to the server console
# instead of emailed (handy for local testing).
#
# --- Gmail (recommended, free ~500/day) -----------------------------
#   Google Account -> Security -> turn ON 2-Step Verification
#   -> App passwords -> generate one for "Mail" -> paste below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
[email protected]
SMTP_PASS=your16charapppassword
[email protected]
#
# --- Yahoo (also works) ---------------------------------------------
#   Yahoo Account Security -> Generate app password -> use it as SMTP_PASS
#   SMTP_HOST=smtp.mail.yahoo.com
#   SMTP_PORT=587
#   [email protected]
#   SMTP_PASS=youryahooapppassword
#
# NOTE: personal Outlook/Hotmail no longer supports app-password SMTP
# (Microsoft disabled Basic Auth for SMTP in 2026). Use Gmail or Yahoo.
# ====================================================================
